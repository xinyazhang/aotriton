#!/bin/bash
# Copyright © 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Initialize PostgreSQL database schema for Tuner v3.5
# Usage: initdb <workdir> [--recreate]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUNE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AOTRITON_ROOT="$(cd "$TUNE_ROOT/.." && pwd)"

. "$TUNE_ROOT/lib/config_load.sh"

WORKDIR="$1"
shift || true

RECREATE_FLAG=""
for arg in "$@"; do
    case "$arg" in
        --recreate) RECREATE_FLAG="--recreate" ;;
        *)
            echo "Usage: $0 <workdir> [--recreate]" >&2
            echo "Error: unrecognized argument: $arg" >&2
            exit 1
            ;;
    esac
done

if [ -z "$WORKDIR" ]; then
    echo "Usage: $0 <workdir> [--recreate]" >&2
    exit 1
fi

load_config "$WORKDIR"

# Path to schema SQL file
SCHEMA_SQL="$AOTRITON_ROOT/python/tune/pq/schema.sql"

if [ ! -f "$SCHEMA_SQL" ]; then
    echo "Error: Schema file not found: $SCHEMA_SQL" >&2
    exit 1
fi

# Validate required config variables
if [ -z "$POSTGRES_USER" ] || [ -z "$POSTGRES_PASSWORD" ]; then
    echo "Error: POSTGRES_USER or POSTGRES_PASSWORD not set in config.rc" >&2
    exit 1
fi

if [ -z "$POSTGRES_DOCKER_IMAGE" ]; then
    echo "Error: POSTGRES_DOCKER_IMAGE not set in config.rc" >&2
    exit 1
fi

# Extract PostgreSQL version from POSTGRES_DOCKER_IMAGE (e.g., postgres:17.6 -> 17.6)
POSTGRES_VERSION=$(echo "$POSTGRES_DOCKER_IMAGE" | cut -d: -f2)

# Use matching psql docker image version
PSQL_IMAGE="alpine/psql:${POSTGRES_VERSION}"

# PostgreSQL connection parameters
# Default to localhost and standard port since containers use --network=host
POSTGRES_HOST="${CELERY_SERVICE_HOST:-localhost}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"

# Drop all tables if --recreate flag is set
if [ "$RECREATE_FLAG" = "--recreate" ]; then
    echo "WARNING: Recreating schema - dropping all tables first..."

    # Drop BOTH schemas the queue owns. `public` holds the parent tables;
    # `shards` holds every (arch, class) partition leaf (see schema.sql).
    # Dropping only `public` was correct before the queue was sharded and is
    # not any more: a partition leaf that outlives its parent would be matched
    # by name by create_arch_partition()'s CREATE TABLE IF NOT EXISTS, making
    # the attach a silent no-op -- the failure would surface much later, as
    # "no partition of relation ... found for row" on insert.
    #
    # `shards` is dropped first so it can never outlive `public`, and both are
    # in one statement so the drop is all-or-nothing.
    docker run --rm \
        --network=host \
        -e PGPASSWORD="$POSTGRES_PASSWORD" \
        "$PSQL_IMAGE" \
        postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
        -v ON_ERROR_STOP=1 \
        -c "DROP SCHEMA IF EXISTS shards CASCADE; DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO $POSTGRES_USER; GRANT ALL ON SCHEMA public TO public;"

    if [ $? -ne 0 ]; then
        echo "Error: Failed to drop existing schema" >&2
        exit 1
    fi

    echo "All tables dropped successfully"
fi

echo "Initializing database schema..."
echo "Host: $POSTGRES_HOST"
echo "Port: $POSTGRES_PORT"
echo "User: $POSTGRES_USER"
echo "Using psql: $PSQL_IMAGE"

# Pull psql image if not present
echo "Pulling psql image: $PSQL_IMAGE"
docker pull "$PSQL_IMAGE"

# Execute schema SQL via containerized psql
# Mount schema file into container and execute it
# ON_ERROR_STOP=1 is what makes the exit-status check below mean anything:
# without it psql runs every remaining statement after a failure and STILL
# exits 0, so a half-applied schema was reported as "initialized successfully".
docker run --rm \
    --network=host \
    -v "$SCHEMA_SQL:/schema.sql:ro" \
    -e PGPASSWORD="$POSTGRES_PASSWORD" \
    "$PSQL_IMAGE" \
    postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
    -v ON_ERROR_STOP=1 \
    -f /schema.sql

if [ $? -ne 0 ]; then
    echo "Error: Failed to initialize database schema" >&2
    exit 1
fi

echo "Database schema initialized successfully"

# Create partitions for all architectures in workers.db
echo "Creating partitions for architectures in workers.db..."
ARCHS=$(sqlite3 "$WORKDIR/workers.db" "SELECT DISTINCT arch FROM workers;" 2>/dev/null)

if [ -z "$ARCHS" ]; then
    echo "Warning: No workers found in workers.db, no partitions created"
else
    for ARCH in $ARCHS; do
        echo "Creating partition for architecture: $ARCH"
        docker run --rm \
            --network=host \
            -e PGPASSWORD="$POSTGRES_PASSWORD" \
            "$PSQL_IMAGE" \
            postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
            -v ON_ERROR_STOP=1 \
            -c "SELECT create_arch_partition('$ARCH');"

        if [ $? -eq 0 ]; then
            echo "  ✓ Partition task_queue_$ARCH created"
        else
            echo "  ✗ Failed to create partition for $ARCH" >&2
            exit 1
        fi
    done
    echo "All partitions created successfully"
fi
