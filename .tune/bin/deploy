#!/bin/bash
# Copyright © 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Deploy workdir to all workers
# Usage: deploy <workdir> [--workload <name>]
#
# --workload kernel (default)  Deploy to Tuner-role hosts;   sync installed/<arch>/.
# --workload op                Deploy to Tuner-role hosts;   sync installed/test/<arch>/.
# --workload perfmon           Deploy to Perfmon-role hosts; sync installed/perfmon/<arch>/.
#
# --tuning_mode is a deprecated alias for --workload.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUNE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

. "$TUNE_ROOT/lib/config_load.sh"
. "$TUNE_ROOT/lib/db_query.sh"

WORKDIR="$1"
shift

WORKLOAD="kernel"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workload)    WORKLOAD="$2"; shift 2 ;;
    --tuning_mode) WORKLOAD="$2"; shift 2 ;;   # deprecated alias
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

if [ -z "$WORKDIR" ]; then
    echo "Usage: $0 <workdir> [--workload kernel|op|perfmon]" >&2
    exit 1
fi

load_config "$WORKDIR"

echo "Deploying from $WORKDIR (workload=$WORKLOAD)"

# The workload picks BOTH which hosts to deploy to and which installed/ subtree
# each one gets. Previously only the subtree varied (op -> --testnode) and the
# host list was always Tuner-role; a perfmon deploy would then have shipped
# tuning libraries to tuning hosts, which is wrong on both counts.
SYNC_FLAG="--workload $WORKLOAD"
if [ "$WORKLOAD" = "perfmon" ]; then
    DEPLOY_ROLE="Perfmon"
else
    DEPLOY_ROLE="Tuner"
fi

mapfile -t WORKER_DATA < <(get_workers "$WORKDIR" "$DEPLOY_ROLE")

if [ "${#WORKER_DATA[@]}" -eq 0 ]; then
    echo "Warning: no hosts hold the $DEPLOY_ROLE role, so nothing will be deployed." >&2
    echo "         Assign it on the WebUI's Workers tab." >&2
fi

for worker in "${WORKER_DATA[@]}"; do
    IFS='|' read -r hostname arch workdir_override <<< "$worker"
    WORKER_WORKDIR="${workdir_override:-$DEFAULT_WORKDIR}"

    echo "Deploying to $hostname ($arch) at $WORKER_WORKDIR"

    "$TUNE_ROOT/single/sync_workdir.sh" "$WORKDIR" "$hostname" $SYNC_FLAG
done

# SLURM deployment if configured
if [ -n "$SLURM_LOGIN_NODE" ]; then
    echo "Deploying to SLURM: $SLURM_LOGIN_NODE at $SLURM_WORKER_DIR"

    "$TUNE_ROOT/single/sync_workdir.sh" "$WORKDIR" "$SLURM_LOGIN_NODE" $SYNC_FLAG
fi

echo "Deployment complete"
