#!/bin/bash
# Copyright © 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Prepare working directory on dev node
# Usage: prepwkdir <workdir> [--workload <name>]

if [ -z "$BASH_VERSION" ]; then
  echo "This script requires Bash. Please run it with 'bash script_name.sh' or ensure /bin/sh points to /bin/bash." >&2
  exit 1
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  cat >&2 <<EOF
Usage: $0 <workdir> [--workload <name>]

Prepare working directory on dev node.

Arguments:
  <workdir>           Project working directory (created by initproj)
  --workload <name>   Which workload's image to prepare, one of:
                        kernel   kernel tuning (default)
                        op       operator tuning
                        perfmon  performance measurement
                      kernel and op share one image: same DAG, same container.
                      perfmon needs its own, and needs perfmon::default_rocm
                      set (WebUI: PerfmonConfig tab).

This script will:
  1. Clone or update AOTriton source to <workdir>/aotriton.src
  2. Copy image.scripts from .tune to <workdir>
  3. Create <workdir>/image.build/Dockerfile
  4. For --workload perfmon, additionally create one
     <workdir>/image.build/Dockerfile.perfmon.<arch> per registered arch
EOF
  exit 1
fi

set -x

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUNE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AOTRITON_ROOT="$(realpath "${TUNE_ROOT}/..")"
WORKDIR=$(realpath "$1")

WORKLOAD="kernel"
if [ "$2" = "--workload" ]; then
  if [ -z "$3" ]; then
    echo "Error: --workload needs a value (kernel|op|perfmon)" >&2
    exit 1
  fi
  WORKLOAD="$3"
elif [ -n "$2" ]; then
  echo "Error: unrecognized argument: $2" >&2
  exit 1
fi

case "$WORKLOAD" in
  kernel|op|perfmon) ;;
  *) echo "Error: unknown workload '$WORKLOAD' (expected kernel|op|perfmon)" >&2; exit 1 ;;
esac

# Validate
if [ ! -d "$WORKDIR" ] || [ ! -f "$WORKDIR/workers.db" ]; then
  echo "Error: Invalid workdir or workers.db not found" >&2
  exit 1
fi

# Step 1: Clone or update AOTriton source
AOTRITON_SRC="$WORKDIR/aotriton.src"

# Get current branch (use -C to avoid cd)
CURRENT_BRANCH=$(git -C "$AOTRITON_ROOT" rev-parse --abbrev-ref HEAD)
if [ -z "$CURRENT_BRANCH" ]; then
  echo "Error: Cannot determine current branch" >&2
  exit 1
fi

# Count commits on HEAD not already reachable from upstream/main or any
# upstream/release/* branch. This is the branch's distance from whichever
# of those bases it was forked from (main or a release branch), computed
# in one shot instead of testing each candidate base individually.
UNIQUE_COMMITS=$(git -C "$AOTRITON_ROOT" rev-list --count HEAD \
  --not upstream/main --remotes='upstream/release/*')
if [ "$UNIQUE_COMMITS" = "$(git -C "$AOTRITON_ROOT" rev-list --count HEAD)" ]; then
  echo "Error: branch shares no history with upstream/main or upstream/release/*" >&2
  echo "Current branch: $CURRENT_BRANCH" >&2
  exit 1
fi
CLONE_DEPTH=$((UNIQUE_COMMITS + 3))

# Try to update existing clone or create new one
if [ -d "$AOTRITON_SRC/.git" ]; then
  echo "Updating existing AOTriton source..."
  if ! git -C "$AOTRITON_SRC" pull --rebase origin "$CURRENT_BRANCH" 2>/dev/null; then
    echo "Pull failed (possibly due to rebase), removing and re-cloning..."
    rm -rf "$AOTRITON_SRC"
    NEED_CLONE=true
  else
    NEED_CLONE=false
  fi
else
  NEED_CLONE=true
fi

if [ "$NEED_CLONE" = true ]; then
  echo "Cloning from local repository (branch: $CURRENT_BRANCH, depth: $CLONE_DEPTH)..."
  git clone --depth "$CLONE_DEPTH" --branch "$CURRENT_BRANCH" "file://$AOTRITON_ROOT" "$AOTRITON_SRC"

  if [ $? -ne 0 ]; then
    echo "Error: Failed to clone AOTriton source" >&2
    exit 1
  fi
fi

# Step 2: Sync image.scripts directory
echo "Syncing image.scripts..."
rsync -a "$TUNE_ROOT/image.scripts/" "$WORKDIR/image.scripts/"

# Step 3: Create Dockerfile
echo "Creating Dockerfile..."
bash "$TUNE_ROOT/lib/create_dockerfile.sh" "$WORKDIR"

# Step 4: workload-specific Dockerfiles.
#
# kernel and op need nothing extra: they share the tuning image made above,
# because they share a DAG and a container -- the workload axis is finer than
# the image axis. perfmon is the one that differs, and per-arch at that,
# because its image bakes an arch-specific ROCm payload
# (rocm[...,device-<arch>]); build_image.sh --workload perfmon then picks the
# one matching the target host's registered arch.
if [ "$WORKLOAD" = "perfmon" ]; then
  . "$TUNE_ROOT/lib/db_query.sh"
  PERFMON_ROCM=$(sqlite3 "$WORKDIR/workers.db" \
    "SELECT COALESCE(value,'') FROM config WHERE key='perfmon::default_rocm'" 2>/dev/null || true)
  if [ -z "$PERFMON_ROCM" ]; then
    echo "Error: --workload perfmon given but perfmon::default_rocm is not set" >&2
    echo "       in $WORKDIR/workers.db. Set it on the WebUI's PerfmonConfig tab." >&2
    exit 1
  fi
  ARCHS=$(get_architectures "$WORKDIR")
  if [ -z "$ARCHS" ]; then
    echo "Error: --workload perfmon given but no architectures are registered in" >&2
    echo "       $WORKDIR/workers.db, so there is nothing to generate." >&2
    exit 1
  fi
  for a in $ARCHS; do
    bash "$TUNE_ROOT/lib/create_perfmon_dockerfile.sh" "$WORKDIR" "$a" "$PERFMON_ROCM"
  done

fi

echo "Working directory preparation completed"
